      {"when":[{"fact":"route","op":"in","value":["business","procurement"]},{"fact":"goods","op":"is","value":false},{"fact":"access_money","op":"is","value":true}],"then":"flag","text":"Money or account access."},
      {"when":[{"fact":"route","op":"in","value":["business","procurement"]},{"fact":"goods","op":"is","value":false},{"fact":"access_level","op":"in","value":["privileged","administrative"]}],"then":"flag","text":"{access_level} access."},
