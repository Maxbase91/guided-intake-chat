      {"when":[{"fact":"route","op":"in","value":["business","procurement"]},{"fact":"goods","op":"is","value":false},{"fact":"outsourcing","op":"is","value":"tbd"}],"then":"flag","text":"Whether this is outsourcing is still open."},
