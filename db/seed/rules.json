  {
    "id": "R27",
    "name": "ICT review (DORA)",
    "step": "Reviews",
    "mode": "advise",
    "clause": "DORA Articles 28–30; ICT third-party risk policy",
    "decides": "Whether new demand or external workers involve an ICT service under DORA.",
    "placeholders": ["ict_type"],
    "outcomes": [
      {"key":"flag","label":"Flag raised","flag":true,"level":"w","title":"ICT review (DORA)","owner":"Risk and IT security"},
      {"key":"none","label":"No flag"}
    ],
    "rows": [
      {"when":[{"fact":"ict_service","op":"is","value":true},{"fact":"route","op":"in","value":["business","procurement"]},{"fact":"ict_ongoing","op":"is","value":true}],"then":"flag","text":"Likely an ICT service: {ict_type}."},
      {"when":[{"fact":"ict_service","op":"is","value":true},{"fact":"route","op":"in","value":["business","procurement"]}],"then":"flag","text":"Possibly an ICT service: {ict_type}. The review confirms."},
      {"when":[{"fact":"ict_service","op":"is","value":true},{"fact":"demand_type","op":"is","value":"contingent_labour"},{"fact":"ict_ongoing","op":"is","value":true}],"then":"flag","text":"Likely an ICT service: {ict_type}."},
      {"when":[{"fact":"ict_service","op":"is","value":true},{"fact":"demand_type","op":"is","value":"contingent_labour"}],"then":"flag","text":"Possibly an ICT service: {ict_type}. The review confirms."},
      {"when":[],"then":"none"}
    ],
    "tests": [
      {"name":"Ongoing ICT service, new demand","given":{"ict_service":true,"route":"procurement","ict_ongoing":true},"expect":"flag"},
      {"name":"One-off ICT work, business-led","given":{"ict_service":true,"route":"business","ict_ongoing":false},"expect":"flag"},
      {"name":"External IT workers on a framework","given":{"ict_service":true,"route":"contract","demand_type":"contingent_labour"},"expect":"flag"},
      {"name":"ICT on an existing contract","given":{"ict_service":true,"route":"contract","demand_type":"services"},"expect":"none"},
      {"name":"No ICT","given":{"ict_service":false,"route":"procurement"},"expect":"none"}
    ]
  },
  {
    "id": "R28",
