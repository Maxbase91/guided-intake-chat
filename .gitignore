# Only the app and its documentation are in Git. Tests, the local server, the mock providers, the data import
# script, the test data, package files and task notes stay on the developer's machine (docs/ARCHITECTURE.md §10).
/*
!/.gitignore
!/index.html
!/api/
!/vercel.json
!/README.md
!/LICENSE
!/NOTICE
!/docs/
**/.DS_Store
