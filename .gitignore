# Allow-list: the app, its documentation, and what is needed to run the tests from a fresh clone (tests, local server,
# mock providers, import script, package files, CI). Test data, task notes and everything else stay on the developer's
# machine (docs/ARCHITECTURE.md §10).
/*
!/.gitignore
!/index.html
!/api/
!/vercel.json
!/README.md
!/CLAUDE.md
!/LICENSE
!/NOTICE
!/docs/
!/tests/
!/scripts/
/scripts/*
!/scripts/dev-server.js
!/scripts/mock-providers.js
!/scripts/import_taxonomy.py
!/package.json
!/package-lock.json
!/playwright.config.js
!/.github/
**/.DS_Store
