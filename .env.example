# Copy to .env for local work with a database. Never commit .env. On Vercel these are project environment variables.
# Without DATABASE_URL the server serves the built-in configuration (db/seed) and keeps nothing.

# Postgres (Neon): the pooled connection for the functions, the direct one for migrations and the seed
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# The page's access code (protects the AI calls, the configuration and the decision log) and the admin page's own code
ACCESS_CODE=
ADMIN_CODE=

# AI providers, free tiers only; at least one
GEMINI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
